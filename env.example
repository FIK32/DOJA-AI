# Appwrite connection (keep API key secret; do not commit your real .env)
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=YOUR_APPWRITE_PROJECT_ID
APPWRITE_API_KEY=YOUR_APPWRITE_SERVER_API_KEY
APPWRITE_DATABASE_ID=YOUR_APPWRITE_DATABASE_ID
APPWRITE_USERS_COLLECTION=users
APPWRITE_SESSIONS_COLLECTION=sessions
APPWRITE_CONVERSATIONS_COLLECTION=conversations
APPWRITE_MESSAGES_COLLECTION=messages
APPWRITE_PROJECTS_COLLECTION=projects
APPWRITE_SETTINGS_COLLECTION=settings

# AI provider (Groq-compatible API)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Set true when deployed behind HTTPS (Render). For local http, set false.
COOKIE_SECURE=true
